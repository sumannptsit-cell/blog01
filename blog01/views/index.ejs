<%- include('partials/header') %>

<section class="hero-section">
    <h1>Welcome to My Blog</h1>
    <p>Create a beautiful, unique blog. It’s quick, free, and easy.</p>
    <a href="/posts/new" class="btn btn-hero">Get Started Now</a>
</section>

<section class="posts-section">
    <h2>Recent Posts</h2>
    
    <% if (posts.length === 0) { %>
        <div class="no-posts">
            <p>No posts yet. Be the first to share something!</p>
            <a href="/posts/new" class="btn btn-primary">Create Post</a>
        </div>
    <% } else { %>
        <div class="posts-grid">
            <% posts.forEach(post => { %>
                <article class="post-card">
                    <div class="card-body">
                        <span class="post-meta">Published by <strong><%= post.author %></strong> on <%= post.date %></span>
                        <h3 class="post-title"><%= post.title %></h3>
                        <p class="post-snippet"><%= post.content.substring(0, 150) %><%= post.content.length > 150 ? '...' : '' %></p>
                    </div>
                    <div class="card-footer">
                        <a href="/posts/<%= post.id %>" class="btn btn-text">Read More &rarr;</a>
                        <div class="card-actions">
                            <a href="/posts/<%= post.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                            <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this post?');">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } %>
</section>

<%- include('partials/footer') %>